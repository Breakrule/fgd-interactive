# ==============================================================================
# STREAMLIT SECRETS TEMPLATE
#
# For LOCAL development: copy this file to `.streamlit/secrets.toml` and fill in
#   the real values (that real file is git-ignored and must NEVER be committed).
# For STREAMLIT COMMUNITY CLOUD: paste the same keys/values into
#   App menu > Settings > Secrets (no file needed).
#
# These credentials make the questionnaire data PERSIST in a Google Sheet instead
# of the ephemeral on-disk CSV (which is wiped on every Streamlit Cloud restart).
# ==============================================================================

# 1) Full URL of the Google Sheet you shared with the service-account email.
gsheet_url = "https://docs.google.com/spreadsheets/d/PASTE_YOUR_SHEET_ID_HERE/edit"

# 2) Service-account credentials = the JSON key downloaded from
#    Google Cloud Console > IAM & Admin > Service Accounts > Keys > Add key > JSON.
#    Each JSON field becomes one key below. IMPORTANT: keep private_key on a
#    SINGLE line using \n escapes exactly as it appears in the JSON file.
[gsheet_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "your-private-key-id"
private_key = "-----BEGIN PRIVATE KEY-----\nMIIEv...YOUR_KEY...\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-project-id.iam.gserviceaccount.com"
client_id = "1234567890"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project-id.iam.gserviceaccount.com"
